.lazy-modular-configurator {
  width: 176;
  height: 169;
  padding-all: 7;
  gap-row: 2;
  align-items: center;
}

.lazy-modular-configurator__title {
  width: 162;
  height: 10;
  text-color: #404040;
  text-shadow: false;
}

.lazy-modular-configurator__storage-group {
  width: 162;
  height: 36;
  gap-row: 0;
}

.lazy-modular-configurator__storage {
  width: 162;
  height: 18;
}

.lazy-modular-configurator__slot {
  width: 18;
  height: 18;
}

.lazy-modular-configurator__inventory-title {
  width: 162;
  height: 11;
  margin-top: 4;
  text-color: #404040;
  text-shadow: false;
}

.lazy-modular-configurator__inventory {
  width: 162;
  height: 77;
}
