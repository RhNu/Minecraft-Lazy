.lazy-planter {
  width: 176;
  height: 176;
  padding-all: 7;
  gap-row: 0;
  align-items: center;
}

.lazy-planter__title {
  width: 162;
  height: 10;
  text-color: #404040;
  text-shadow: false;
}

.lazy-planter__machine {
  width: 162;
  height: 54;
  gap-column: 0;
  justify-content: center;
  align-items: flex-start;
}

.lazy-planter__inputs {
  width: 18;
  height: 54;
  gap-row: 0;
}

.lazy-planter__center {
  width: 72;
  height: 54;
  gap-row: 4;
  align-items: flex-start;
  justify-content: flex-start;
}

.lazy-planter__progress {
  width: 48;
  height: 16;
  margin-left: 12;
}

.lazy-planter__actions {
  width: 54;
  height: 16;
  gap-column: 3;
  justify-content: center;
  margin-left: 9;
  margin-top: 16;
}

.lazy-planter__icon-button {
  width: 16;
  height: 16;
  padding-all: 1;
}

.lazy-planter__toggle-button {
  base-background: built-in(ui-mc:RECT_3);
  hover-background: built-in(ui-mc:RECT_3) color(#dddddd);
  pressed-background: built-in(ui-mc:RECT_BORDER);
}

.lazy-planter__icon-button--enabled {
  base-background: built-in(ui-mc:RECT_BORDER);
  hover-background: built-in(ui-mc:RECT_BORDER) color(#dddddd);
  pressed-background: built-in(ui-mc:RECT_3);
}

.lazy-planter__action-placeholder {
  width: 16;
  height: 16;
}

.lazy-planter__outputs {
  width: 72;
  height: 54;
}

.lazy-planter__output-row {
  width: 72;
  height: 18;
}

.lazy-planter__slot {
  width: 18;
  height: 18;
}

.lazy-planter__inventory-title {
  width: 162;
  height: 11;
  text-color: #404040;
  text-shadow: false;
}

.lazy-planter__inventory {
  width: 162;
  height: 77;
}
