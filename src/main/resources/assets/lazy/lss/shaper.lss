.lazy-shaper {
  width: 176;
  height: 190;
  padding-all: 7;
  gap-row: 4;
  align-items: center;
}

.lazy-shaper__title {
  width: 100%;
  height: 10;
  horizontal-align: center;
  text-color: #404040;
  text-shadow: false;
}

.lazy-shaper__settings {
  width: 100%;
  height: 18;
  gap-column: 4;
  justify-content: center;
  align-items: center;
}

.lazy-shaper__warning {
  width: 18;
  height: 18;
  padding-all: 1;
}

.lazy-shaper__storage {
  width: 100%;
  height: 48;
  gap-column: 8;
  justify-content: center;
}

.lazy-shaper__lane-group {
  width: 72;
  height: 48;
  gap-row: 1;
}

.lazy-shaper__lane-title {
  width: 72;
  height: 10;
  horizontal-align: center;
  text-color: #404040;
  text-shadow: false;
}

.lazy-shaper__lane-row {
  width: 72;
  height: 18;
  gap-column: 0;
}

.lazy-shaper__slot {
  width: 18;
  height: 18;
}

.lazy-shaper__inventory-title {
  width: 162;
  height: 9;
  text-color: #404040;
  text-shadow: false;
}

.lazy-shaper__inventory {
  width: 162;
  height: 77;
}
