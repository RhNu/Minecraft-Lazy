.lazy-io__trigger {
  width: 16;
  height: 16;
  padding-all: 1;
  base-background: built-in(ui-mc:RECT_3);
  hover-background: built-in(ui-mc:RECT_3) color(#dddddd);
  pressed-background: built-in(ui-mc:RECT_BORDER);
}

.lazy-configuration-card {
  width: 176;
  padding-all: 7;
  gap-row: 7;
  align-items: center;
}

.lazy-configuration-card__inventory {
  margin-top: 4;
}

.lazy-io__panel {
  width: 166;
  min-height: 112;
  padding-all: 6;
  gap-row: 5;
  align-items: center;
}

.lazy-io__title {
  height: 10;
  horizontal-align: center;
  text-color: #404040;
  text-shadow: false;
}

.lazy-io__tabs {
  width: 154;
  height: 20;
  gap-column: 2;
  justify-content: center;
}

.lazy-io__tab {
  width: 50;
  height: 20;
  padding-horizontal: 3;
  base-background: built-in(ui-mc:RECT_3);
  hover-background: built-in(ui-mc:RECT_3) color(#dddddd);
  pressed-background: built-in(ui-mc:RECT_BORDER);
  text-color: #404040;
  text-shadow: false;
}

.lazy-io__content {
  width: 154;
  min-height: 67;
  padding-all: 4;
  gap-row: 4;
  align-items: center;
  justify-content: center;
  base-background: built-in(ui-mc:RECT_BORDER);
}

.lazy-io__passive-icon {
  width: 24;
  height: 24;
  padding-all: 4;
  base-background: built-in(ui-mc:RECT_3);
}

.lazy-io__face-grid {
  gap-row: 2;
  align-items: center;
}

.lazy-io__face-row {
  height: 18;
  gap-column: 2;
}

.lazy-io__face-button,
.lazy-io__face-placeholder {
  width: 18;
  height: 18;
}

.lazy-io__face-button {
  padding-all: 1;
  text-color: #ffffff;
  text-shadow: true;
}

.lazy-io__face--none {
  base-background: built-in(ui-mc:RECT_3) color(#707070);
}

.lazy-io__face--input {
  base-background: built-in(ui-mc:RECT_3) color(#3f78d4);
}

.lazy-io__face--output {
  base-background: built-in(ui-mc:RECT_3) color(#d66a35);
}

.lazy-io__face--both {
  base-background: built-in(ui-mc:RECT_3) color(#9b52c7);
}

.lazy-io__eject {
  width: 74;
  height: 18;
  padding-horizontal: 3;
  base-background: built-in(ui-mc:RECT_3);
  hover-background: built-in(ui-mc:RECT_3) color(#dddddd);
  pressed-background: built-in(ui-mc:RECT_BORDER);
  text-color: #404040;
  text-shadow: false;
}

.lazy-io__network-list {
  width: 144;
  gap-row: 2;
  align-items: stretch;
}

.lazy-io__provider-button {
  width: 144;
  height: 20;
  padding-horizontal: 3;
  base-background: built-in(ui-mc:RECT_3);
  hover-background: built-in(ui-mc:RECT_3) color(#dddddd);
  pressed-background: built-in(ui-mc:RECT_BORDER);
  text-color: #404040;
  text-shadow: false;
}

.lazy-io__network-empty {
  horizontal-align: center;
  text-color: #777777;
  text-shadow: false;
}

.lazy-io__network-status {
  width: 144;
  horizontal-align: center;
  text-color: #404040;
  text-shadow: false;
}

.lazy-io__network-actions {
  width: 144;
  height: 16;
  gap-column: 2;
  justify-content: center;
}

.lazy-io__network-action {
  width: 71;
  height: 16;
  padding-horizontal: 3;
  base-background: built-in(ui-mc:RECT_3);
  hover-background: built-in(ui-mc:RECT_3) color(#dddddd);
  pressed-background: built-in(ui-mc:RECT_BORDER);
  text-color: #404040;
  text-shadow: false;
}

.lazy-io__button--selected {
  base-background: built-in(ui-mc:RECT_BORDER);
  hover-background: built-in(ui-mc:RECT_BORDER);
  pressed-background: built-in(ui-mc:RECT_BORDER);
}
