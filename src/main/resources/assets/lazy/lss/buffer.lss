.lazy-buffer {
  width: 220;
  height: 202;
  padding-all: 7;
  gap-row: 4;
}

.lazy-buffer__title {
  width: 100%;
  height: 10;
  horizontal-align: center;
  text-color: #404040;
  text-shadow: false;
}

.lazy-buffer__summary {
  width: 100%;
  height: 18;
  horizontal-align: center;
  text-wrap: wrap;
  text-color: #404040;
  text-shadow: false;
}

.lazy-buffer__section-title {
  width: 100%;
  height: 9;
  text-color: #404040;
  text-shadow: false;
}

.lazy-buffer__items {
  width: 100%;
  height: 31;
  gap-column: 4;
  justify-content: center;
}

.lazy-buffer__item {
  width: 22;
  height: 31;
  gap-row: 2;
  align-items: center;
}

.lazy-buffer__item item-slot {
  width: 18;
  height: 18;
}

.lazy-buffer__amount {
  width: 22;
  height: 9;
  horizontal-align: center;
  font-size: 7;
  text-color: #404040;
  text-shadow: false;
}

.lazy-buffer__fluids {
  width: 100%;
  height: 70;
  gap-row: 4;
}

.lazy-buffer__fluid-row {
  width: 100%;
  height: 33;
  gap-column: 6;
  justify-content: center;
}

.lazy-buffer__fluid {
  width: 98;
  height: 33;
  gap-row: 2;
}

.lazy-buffer__fluid-name {
  width: 98;
  height: 9;
  text-color: #404040;
  text-shadow: false;
  text-wrap: hover-roll;
}

.lazy-buffer__fluid fluid-slot {
  width: 98;
  height: 22;
}

.lazy-buffer__actions {
  width: 100%;
  height: 16;
  gap-column: 4;
  justify-content: center;
  align-items: center;
}

.lazy-buffer__network-status {
  width: 34;
  height: 9;
  horizontal-align: center;
  font-size: 7;
  text-color: #404040;
  text-shadow: false;
}

.lazy-buffer__network-toggle {
  width: 68;
}

.lazy-buffer__clear {
  width: 64;
}

.lazy-buffer__confirmation-layer {
  background: #A0000000;
}

.lazy-buffer__confirmation {
  width: 176;
  height: 76;
  gap-row: 6;
  align-items: center;
}

.lazy-buffer__confirmation-title {
  width: 100%;
  height: 10;
  horizontal-align: center;
  text-color: #404040;
  text-shadow: false;
}

.lazy-buffer__confirmation-description {
  width: 158;
  height: 18;
  horizontal-align: center;
  text-wrap: wrap;
  text-color: #404040;
  text-shadow: false;
}

.lazy-buffer__confirmation-actions {
  width: 100%;
  height: 16;
  gap-column: 8;
  justify-content: center;
}

.lazy-buffer__confirmation-button {
  width: 64;
}
