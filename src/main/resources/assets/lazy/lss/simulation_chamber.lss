.lazy-simulation {
  width: 176;
  height: 184;
  padding-all: 7;
  gap-row: 0;
  align-items: center;
}

.lazy-simulation__title {
  width: 162;
  height: 10;
  text-color: #404040;
  text-shadow: false;
}

.lazy-simulation__machine {
  width: 162;
  height: 60;
  gap-row: 3;
  align-items: center;
}

.lazy-simulation__inputs {
  width: 162;
  height: 18;
  gap-column: 4;
  justify-content: center;
  margin-bottom: 2;
}

.lazy-simulation__processing {
  width: 162;
  height: 18;
  gap-column: 4;
  justify-content: center;
  align-items: center;
}

.lazy-simulation__progress {
  width: 90;
  height: 16;
}

.lazy-simulation__actions {
  width: 162;
  height: 16;
  gap-column: 3;
  justify-content: center;
}

.lazy-simulation__icon-button {
  width: 16;
  height: 16;
  padding-all: 1;
}

.lazy-simulation__action-placeholder {
  width: 16;
  height: 16;
}

.lazy-simulation__slot {
  width: 18;
  height: 18;
}

.lazy-simulation__inventory-title {
  width: 162;
  height: 11;
  text-color: #404040;
  text-shadow: false;
}

.lazy-simulation__inventory {
  width: 162;
  height: 77;
}
