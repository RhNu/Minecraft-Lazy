.lazy-essence-converter {
  width: 176;
  height: 155;
  padding-all: 7;
  gap-row: 4;
  align-items: center;
}

.lazy-essence-converter__status {
  width: 162;
  height: 16;
  gap-column: 4;
  align-items: center;
}

.lazy-essence-converter__counter {
  height: 16;
  background: built-in(ui-mc:RECT_5);
  horizontal-align: center;
  vertical-align: center;
  text-color: #404040;
  text-shadow: false;
}

.lazy-essence-converter__amount {
  width: 126;
}

.lazy-essence-converter__remainder {
  width: 32;
}

.lazy-essence-converter__targets {
  width: 162;
  height: 18;
  gap-column: 4;
  justify-content: center;
  align-items: center;
}

.lazy-essence-converter__controls {
  width: 162;
  height: 18;
  align-items: center;
}

.lazy-essence-converter__actions {
  width: 62;
  height: 18;
  gap-column: 4;
  margin-left: 82;
  align-items: center;
}

.lazy-essence-converter__icon-button {
  width: 18;
  height: 18;
  padding-all: 1;
  base-background: built-in(ui-mc:RECT_3);
  hover-background: built-in(ui-mc:RECT_3) color(#dddddd);
  pressed-background: built-in(ui-mc:RECT_BORDER);
}

.lazy-essence-converter__icon-button--selected {
  base-background: built-in(ui-mc:RECT_BORDER);
  hover-background: built-in(ui-mc:RECT_BORDER) color(#dddddd);
  pressed-background: built-in(ui-mc:RECT_3);
}

.lazy-essence-converter__slot {
  width: 18;
  height: 18;
}

.lazy-essence-converter__locked-input {
  base-background: built-in(ui-mc:RECT_1);
}

.lazy-essence-converter__inventory {
  width: 162;
  height: 77;
}

.lazy-essence-converter__confirmation-layer {
  background: #A0000000;
}

.lazy-essence-converter__confirmation {
  width: 176;
  height: 62;
  gap-row: 8;
  align-items: center;
  justify-content: center;
}
