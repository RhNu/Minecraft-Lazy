.lazy-buffer {
  width: 176;
  height: 84;
  padding-all: 7;
  gap-row: 4;
}

.lazy-buffer__title {
  width: 100%;
  height: 10;
  horizontal-align: left;
  text-color: #404040;
  text-shadow: false;
}

.lazy-buffer__storage {
  width: 100%;
  height: 36;
  gap-column: 0;
  justify-content: center;
}

.lazy-buffer__items {
  width: 72;
  height: 36;
  gap-row: 0;
}

.lazy-buffer__item-row {
  width: 72;
  height: 18;
  gap-column: 0;
}

.lazy-buffer__item-slot {
  width: 18;
  height: 18;
}

.lazy-buffer__fluids {
  width: 72;
  height: 36;
  gap-column: 0;
}

.lazy-buffer__fluid {
  width: 18;
  height: 36;
}

.lazy-buffer__actions {
  width: 100%;
  height: 16;
  gap-column: 4;
  justify-content: center;
  align-items: center;
}

.lazy-buffer__icon-button {
  width: 16;
  height: 16;
  padding-all: 1;
}

.lazy-buffer__toggle-button {
  base-background: built-in(ui-mc:RECT_3);
  hover-background: built-in(ui-mc:RECT_3) color(#dddddd);
  pressed-background: built-in(ui-mc:RECT_BORDER);
}

.lazy-buffer__icon-button--enabled {
  base-background: built-in(ui-mc:RECT_BORDER);
  hover-background: built-in(ui-mc:RECT_BORDER) color(#dddddd);
  pressed-background: built-in(ui-mc:RECT_3);
}

.lazy-buffer__confirmation-layer {
  background: #A0000000;
}

.lazy-buffer__confirmation {
  width: 176;
  height: 76;
  gap-row: 6;
  align-items: center;
}

.lazy-buffer__confirmation-title {
  width: 100%;
  height: 10;
  horizontal-align: center;
  text-color: #404040;
  text-shadow: false;
}

.lazy-buffer__confirmation-description {
  width: 158;
  height: 18;
  horizontal-align: center;
  text-wrap: wrap;
  text-color: #404040;
  text-shadow: false;
}

.lazy-buffer__confirmation-actions {
  width: 100%;
  height: 16;
  gap-column: 8;
  justify-content: center;
}

.lazy-buffer__confirmation-button {
  width: 64;
}
