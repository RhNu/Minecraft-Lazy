.lazy-replicator {
  width: 176;
  height: 143;
  padding-all: 7;
  gap-row: 5;
  align-items: center;
}

.lazy-replicator__title {
  width: 100%;
  height: 10;
  horizontal-align: left;
  text-color: #404040;
  text-shadow: false;
}

.lazy-replicator__controls {
  width: 100%;
  height: 18;
  gap-column: 8;
  justify-content: center;
  align-items: center;
}

.lazy-replicator__resource-slot,
.lazy-replicator__resource-layer {
  width: 18;
  height: 18;
}

.lazy-replicator__resource-layer {
  padding-all: 1;
}

.lazy-replicator__amount {
  width: 50;
  height: 18;
  padding-all: 2;
}

.lazy-replicator__gear {
  width: 52;
  height: 18;
  padding-all: 2;
}

.lazy-replicator__inventory-title {
  width: 162;
  height: 9;
  text-color: #404040;
  text-shadow: false;
}

.lazy-replicator__inventory {
  width: 162;
  height: 77;
}

.lazy-replicator__amount-editor {
  width: 138;
  padding-all: 8;
  gap-row: 6;
  align-items: center;
}

.lazy-replicator__amount-title {
  width: 122;
  height: 10;
  horizontal-align: center;
}

.lazy-replicator__amount-row {
  height: 18;
  gap-column: 4;
  align-items: center;
}

.lazy-replicator__amount-step {
  width: 18;
  height: 18;
}

.lazy-replicator__amount-field {
  width: 78;
  height: 18;
}

.lazy-replicator__amount-done {
  width: 48;
  height: 18;
}
