.lazy-energy-source {
  width: 82;
  height: 50;
  padding-all: 7;
  gap-row: 6;
  align-items: center;
}

.lazy-energy-source__title {
  width: 68;
  height: 10;
  horizontal-align: left;
  text-color: #404040;
  text-shadow: false;
}

.lazy-energy-source__modes {
  width: 68;
  height: 20;
  gap-column: 4;
  justify-content: center;
}

.lazy-energy-source__mode {
  width: 20;
  height: 20;
  padding-all: 2;
  base-background: built-in(ui-mc:RECT_3);
  hover-background: built-in(ui-mc:RECT_3) color(#dddddd);
  pressed-background: built-in(ui-mc:RECT_BORDER);
}

.lazy-energy-source__mode--selected {
  base-background: built-in(ui-mc:RECT_BORDER);
  hover-background: built-in(ui-mc:RECT_BORDER) color(#dddddd);
  pressed-background: built-in(ui-mc:RECT_3);
}
