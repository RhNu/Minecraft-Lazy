.lazy-teleporter {
  width: 310;
  height: 190;
  padding-all: 8;
  gap-row: 5;
}

.lazy-teleporter__title {
  width: 100%;
  height: 12;
  horizontal-align: center;
  text-color: #404040;
  text-shadow: false;
}

.lazy-teleporter__body {
  width: 100%;
  height: 157;
  gap-column: 8;
}

.lazy-teleporter__left {
  width: 174;
  height: 100%;
  gap-row: 4;
}

.lazy-teleporter__list-actions {
  width: 100%;
  height: 18;
  gap-column: 2;
  align-items: center;
}

.lazy-teleporter__list {
  width: 174;
  height: 135;
  padding-all: 2;
  gap-row: 2;
  background: built-in(ui-mc:RECT_BORDER);
}

.lazy-teleporter__space-row {
  width: 166;
  height: 18;
  padding-horizontal: 3;
  base-background: built-in(ui-mc:RECT_3);
  hover-background: built-in(ui-mc:RECT_3) color(#dceeff);
  pressed-background: built-in(ui-mc:RECT_BORDER);
}

.lazy-teleporter__space-label {
  width: 158;
  height: 10;
  text-color: #404040;
  text-shadow: false;
}

.lazy-teleporter__details {
  width: 112;
  height: 100%;
  gap-row: 4;
}

.lazy-teleporter__selected-name,
.lazy-teleporter__uuid,
.lazy-teleporter__owner {
  width: 100%;
  height: 10;
  text-color: #404040;
  text-shadow: false;
}

.lazy-teleporter__owner {
  text-wrap: wrap;
  height: 20;
}

.lazy-teleporter__rename {
  width: 100%;
  height: 18;
}

.lazy-teleporter__action {
  min-width: 18;
  height: 18;
  padding-horizontal: 3;
  base-background: built-in(ui-mc:RECT_3);
  hover-background: built-in(ui-mc:RECT_3) color(#dddddd);
  pressed-background: built-in(ui-mc:RECT_BORDER);
}

.lazy-teleporter__details .lazy-teleporter__action {
  width: 100%;
}

.lazy-teleporter__page {
  width: 32;
  height: 10;
  horizontal-align: center;
  text-color: #404040;
  text-shadow: false;
}

.lazy-teleporter__delete {
  base-background: built-in(ui-mc:RECT_3) color(#d89696);
  hover-background: built-in(ui-mc:RECT_3) color(#efaaaa);
  pressed-background: built-in(ui-mc:RECT_BORDER) color(#c47d7d);
}

.lazy-teleporter__confirm {
  width: 210;
  height: 72;
  padding-all: 8;
  gap-row: 8;
  align-items: center;
  background: built-in(ui-mc:RECT_3);
}

.lazy-teleporter__confirm-text {
  width: 194;
  height: 30;
  horizontal-align: center;
  text-wrap: wrap;
  text-color: #404040;
  text-shadow: false;
}

.lazy-teleporter__confirm-actions {
  height: 18;
  gap-column: 8;
  justify-content: center;
}

.lazy-teleporter__confirm-button {
  width: 86;
  height: 18;
}
