.lazy-item-copier {
  width: 176;
  height: 143;
  padding-all: 7;
  gap-row: 5;
  align-items: center;
}

.lazy-item-copier__title {
  width: 100%;
  height: 10;
  horizontal-align: center;
  text-color: #404040;
  text-shadow: false;
}

.lazy-item-copier__controls {
  width: 100%;
  height: 18;
  gap-column: 8;
  justify-content: center;
  align-items: center;
}

.lazy-item-copier__template {
  width: 18;
  height: 18;
  padding-all: 1;
}

.lazy-item-copier__gear {
  width: 52;
  height: 18;
  padding-all: 2;
}

.lazy-item-copier__inventory-title {
  width: 162;
  height: 9;
  text-color: #404040;
  text-shadow: false;
}

.lazy-item-copier__inventory {
  width: 162;
  height: 77;
}
