/*
 * IO configuration panel.
 *
 * The panel body has a fixed height, computed in IoPanelUI from the heights and gaps declared here
 * so that switching tabs never resizes the window. Keep the two in step when editing sizes.
 */

.lazy-io__trigger {
  width: 16;
  height: 16;
  padding-all: 1;
  base-background: built-in(ui-mc:RECT_3);
  hover-background: built-in(ui-mc:RECT_3) color(#dddddd);
  pressed-background: built-in(ui-mc:RECT_BORDER);
}

.lazy-io__panel {
  width: 166;
  padding-all: 6;
  gap-row: 4;
  align-items: center;
}

.lazy-io__title {
  width: 100%;
  height: 10;
  horizontal-align: left;
  vertical-align: center;
  text-color: #404040;
  text-shadow: false;
}

/* tabs */

.lazy-io__tabs {
  width: 100%;
  height: 18;
  gap-column: 2;
  justify-content: center;
}

.lazy-io__tab {
  width: 50;
  height: 18;
  padding-horizontal: 2;
  base-background: built-in(ui-mc:RECT_3);
  hover-background: built-in(ui-mc:RECT_3) color(#dddddd);
  pressed-background: built-in(ui-mc:RECT_BORDER);
}

.lazy-io__tab .__button_text__ {
  text-color: #404040;
  text-shadow: false;
}

.lazy-io__body {
  width: 100%;
  padding-all: 4;
  background: built-in(ui-mc:RECT_BORDER);
}

.lazy-io__content {
  width: 100%;
  height: 100%;
  gap-row: 4;
  align-items: center;
  justify-content: center;
}

/* passive tab */

.lazy-io__passive-icon {
  width: 24;
  height: 24;
  padding-all: 4;
  base-background: built-in(ui-mc:RECT_3);
}

.lazy-io__hint {
  width: 100%;
  height: 20;
  horizontal-align: center;
  vertical-align: center;
  text-wrap: wrap;
  text-color: #555555;
  text-shadow: false;
}

/* face tab */

.lazy-io__face-grid {
  gap-row: 2;
  align-items: center;
}

.lazy-io__face-row {
  height: 18;
  gap-column: 2;
}

.lazy-io__face {
  width: 18;
  height: 18;
  padding-all: 1;
}

.lazy-io__face-placeholder {
  width: 18;
  height: 18;
}

.lazy-io__face .__button_text__ {
  text-color: #ffffff;
  text-shadow: true;
}

.lazy-io__face--none {
  base-background: built-in(ui-mc:RECT_3) color(#707070);
  hover-background: built-in(ui-mc:RECT_3) color(#8c8c8c);
  pressed-background: built-in(ui-mc:RECT_BORDER) color(#707070);
}

.lazy-io__face--input {
  base-background: built-in(ui-mc:RECT_3) color(#3f78d4);
  hover-background: built-in(ui-mc:RECT_3) color(#5b93e8);
  pressed-background: built-in(ui-mc:RECT_BORDER) color(#3f78d4);
}

.lazy-io__face--output {
  base-background: built-in(ui-mc:RECT_3) color(#d66a35);
  hover-background: built-in(ui-mc:RECT_3) color(#ea8552);
  pressed-background: built-in(ui-mc:RECT_BORDER) color(#d66a35);
}

.lazy-io__face--both {
  base-background: built-in(ui-mc:RECT_3) color(#9b52c7);
  hover-background: built-in(ui-mc:RECT_3) color(#b16fda);
  pressed-background: built-in(ui-mc:RECT_BORDER) color(#9b52c7);
}

.lazy-io__eject {
  width: 18;
  height: 18;
  padding-all: 1;
  base-background: built-in(ui-mc:RECT_3);
  hover-background: built-in(ui-mc:RECT_3) color(#dddddd);
  pressed-background: built-in(ui-mc:RECT_BORDER);
}

/* network tab */

.lazy-io__network-status {
  width: 100%;
  height: 14;
  padding-horizontal: 3;
  background: built-in(ui-mc:RECT_BLACK);
  horizontal-align: center;
  vertical-align: center;
  text-color: #e0e0e0;
  text-shadow: false;
}

.lazy-io__network-list {
  width: 100%;
  gap-row: 2;
  align-items: center;
  justify-content: center;
}

.lazy-io__network-empty {
  width: 100%;
  height: 10;
  horizontal-align: center;
  vertical-align: center;
  text-color: #777777;
  text-shadow: false;
}

.lazy-io__provider {
  width: 100%;
  height: 18;
  padding-horizontal: 3;
  base-background: built-in(ui-mc:RECT_3);
  hover-background: built-in(ui-mc:RECT_3) color(#dddddd);
  pressed-background: built-in(ui-mc:RECT_BORDER);
}

.lazy-io__provider .__button_text__ {
  text-color: #404040;
  text-shadow: false;
}

.lazy-io__network-actions {
  width: 100%;
  height: 16;
  gap-column: 4;
  justify-content: center;
}

.lazy-io__network-action {
  width: 71;
  height: 16;
  padding-horizontal: 2;
  base-background: built-in(ui-mc:RECT_3);
  hover-background: built-in(ui-mc:RECT_3) color(#dddddd);
  pressed-background: built-in(ui-mc:RECT_BORDER);
}

.lazy-io__network-action .__button_text__ {
  text-color: #404040;
  text-shadow: false;
}

.lazy-io__button--selected {
  base-background: built-in(ui-mc:RECT_BORDER);
  hover-background: built-in(ui-mc:RECT_BORDER);
  pressed-background: built-in(ui-mc:RECT_BORDER);
}
