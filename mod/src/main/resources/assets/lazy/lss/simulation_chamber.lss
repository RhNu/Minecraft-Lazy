.lazy-simulation {
  width: 176;
  height: 188;
  padding-all: 7;
  gap-row: 0;
  align-items: center;
}

.lazy-simulation__title {
  width: 162;
  height: 10;
  text-color: #404040;
  text-shadow: false;
}

.lazy-simulation__machine {
  width: 162;
  height: 64;
  gap-row: 3;
  align-items: center;
}

.lazy-simulation__inputs {
  width: 162;
  height: 18;
  gap-column: 4;
  justify-content: center;
  margin-bottom: 2;
}

.lazy-simulation__processing {
  width: 162;
  height: 18;
  gap-column: 4;
  justify-content: center;
  align-items: center;
}

.lazy-simulation__progress {
  width: 90;
  height: 16;
}

/*
 * Tool row. Its 16 + 4 + 90 + 4 + 16 span matches the processing row exactly, so the IO trigger
 * lands under the output multiplier icon and the pending warning under the speed one, while the
 * three slots stay centred inside the 90 wide middle section.
 */
.lazy-simulation__tools {
  width: 162;
  height: 18;
  gap-column: 4;
  justify-content: center;
  align-items: center;
  margin-top: 2;
}

.lazy-simulation__tool-slots {
  width: 90;
  height: 18;
  gap-column: 4;
  justify-content: center;
}

.lazy-simulation__icon-button {
  width: 16;
  height: 16;
  padding-all: 1;
}

.lazy-simulation__slot {
  width: 18;
  height: 18;
}

.lazy-simulation__inventory-title {
  width: 162;
  height: 11;
  text-color: #404040;
  text-shadow: false;
}

.lazy-simulation__inventory {
  width: 162;
  height: 77;
}
